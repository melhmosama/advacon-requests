{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/asset",
      "destination": "/index.html"
    },
    {
      "source": "/housing",
      "destination": "/housing.html"
    },
    {
      "source": "/warehouse",
      "destination": "/warehouse.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
